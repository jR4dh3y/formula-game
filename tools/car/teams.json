{
  "season": 2022,
  "livery_styles": {
    "space": "Normalised car space for surface points. x: lateral, -1 right to +1 left. y: height, 0 at the floor to 1 at the top of the airbox. z: longitudinal, 0 at the nose tip to 1 at the rear wing. Every shape is symmetric in x and spans the full width, so no style reads x; it is kept for the coordinate contract. Painted surfaces are bodywork only (not wings, wheels or the driver).",
    "roles": {
      "description": "A colour role names one entry of the team's colors object. carbon is the exposed carbon-fibre tone and the default for halo and other dark parts.",
      "values": ["primary", "secondary", "accent", "carbon"]
    },
    "styles": {
      "solid": {
        "description": "Whole bodywork in primary. No style parameters. Common keys still apply.",
        "params": {}
      },
      "split": {
        "description": "Bodywork below the height line h(z) = split_y + split_slope * z takes secondary; bodywork at or above it takes primary.",
        "params": {
          "split_y": {
            "type": "number",
            "min": 0.0,
            "max": 1.0,
            "description": "Height of the split line at the nose tip (z = 0)."
          },
          "split_slope": {
            "type": "number",
            "min": -0.5,
            "max": 0.5,
            "description": "Change in split height per unit of z. 0 gives a level split."
          }
        }
      },
      "fade": {
        "description": "Bodywork colour is lerp(primary, secondary, t) with t = clamp((z - fade_z0) / (fade_z1 - fade_z0), 0, 1). Primary at or before fade_z0, secondary at or after fade_z1.",
        "params": {
          "fade_z0": {
            "type": "number",
            "min": 0.0,
            "max": 1.0,
            "description": "z where the fade starts. Must be less than fade_z1."
          },
          "fade_z1": {
            "type": "number",
            "min": 0.0,
            "max": 1.0,
            "description": "z where the fade reaches secondary. Must be greater than fade_z0."
          }
        }
      },
      "stripe": {
        "description": "Bodywork points with |y - stripe_y| <= stripe_w / 2 take stripe_color, over the full length of the body. Painted over the base colour.",
        "params": {
          "stripe_y": {
            "type": "number",
            "min": 0.0,
            "max": 1.0,
            "description": "Centre height of the stripe."
          },
          "stripe_w": {
            "type": "number",
            "min": 0.01,
            "max": 0.3,
            "description": "Full height of the stripe in car-space units."
          },
          "stripe_color": {
            "type": "role",
            "description": "Colour role for the stripe."
          }
        }
      },
      "band": {
        "description": "Bodywork points with |z - band_z| <= band_w / 2 take band_color, across the full width and height of the body (engine cover and nose). Painted over the base colour.",
        "params": {
          "band_z": {
            "type": "number",
            "min": 0.0,
            "max": 1.0,
            "description": "Centre z of the band."
          },
          "band_w": {
            "type": "number",
            "min": 0.01,
            "max": 0.3,
            "description": "Full length of the band along z."
          },
          "band_color": {
            "type": "role",
            "description": "Colour role for the band."
          }
        }
      }
    },
    "common": {
      "nose_tip": {
        "type": "role_or_null",
        "description": "Colour role for the nose tip (z <= 0.12). null keeps the base colour."
      },
      "wing_endplates": {
        "type": "role",
        "description": "Colour role for front and rear wing endplates."
      },
      "halo": {
        "type": "role",
        "description": "Colour role for the halo."
      },
      "text_color": {
        "type": "role",
        "description": "Colour role for the team short name printed on the sidepods and the rear wing. Pick the role that contrasts with the paint there."
      }
    }
  },
